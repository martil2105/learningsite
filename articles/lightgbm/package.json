{
  "name": "lightgbm",
  "version": "1.0.0",
  "description": "MLU-Explain-style interactive article on LightGBM's histogram binning: how bucketing a feature turns split finding from a scan over rows into a scan over bins, and what it costs in accuracy.",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public -D -m 1",
    "check": "node verify/check-numbers.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.0",
    "rollup": "^2.41.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.0.0"
  },
  "dependencies": {
    "d3-array": "^2.12.1",
    "d3-scale": "^3.3.0",
    "katex": "^0.12.0",
    "sirv-cli": "^1.0.0",
    "svelte-preprocess": "^4.6.9"
  }
}
